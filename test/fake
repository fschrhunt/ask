#!/usr/bin/env node
/*
 * A fake agent for the tests, keeping the agent contract (docs/agents.md). `fake models`
 * lists "small<TAB>Small One" and "big". A run appends {pid, stdin, cwd, access, model, effort,
 * schema, session, contract} to $FAKE_LOG, reports its session at once (ASK_SESSION, or a new "s-<pid>"),
 * answers $FAKE_ANSWER (default "fake: <last prompt line>") and reports name "Fake 1.0", 10 in,
 * 5 out, $0.01. A prompt containing $FAKE_FAIL fails with "fake boom", $FAKE_HANG never returns,
 * $FAKE_SLOW answers after 300 ms. $FAKE_IGNORE_TERM ignores SIGTERM, $FAKE_EXIT is the exit code
 * after an answer, $FAKE_NOTE is reported as the note, $FAKE_NO_USAGE reports no usage,
 * $FAKE_WRITE="file=text" writes a file in the working directory and $FAKE_COMMIT commits all.
 */
import { execFileSync } from 'node:child_process';
import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';

const env = process.env;
if (process.argv[2] === 'models') {
  console.log('small\tSmall One\nbig');
  process.exit(0);
}
const stdin = readFileSync(0, 'utf8');
const schema = env.ASK_SCHEMA ? JSON.parse(readFileSync(env.ASK_SCHEMA, 'utf8')) : undefined;
if (env.FAKE_LOG)
  appendFileSync(
    env.FAKE_LOG,
    JSON.stringify({ pid: process.pid, stdin, cwd: process.cwd(), access: env.ASK_ACCESS, model: env.ASK_MODEL, effort: env.ASK_EFFORT, schema, session: env.ASK_SESSION, contract: env.ASK_CONTRACT }) + '\n',
  );
const matches = (needle) => needle && stdin.includes(needle);
const session = env.ASK_SESSION || `s-${process.pid}`;
writeFileSync(env.ASK_REPORT, JSON.stringify({ session }));
if (env.FAKE_WRITE) writeFileSync(env.FAKE_WRITE.split('=')[0], env.FAKE_WRITE.split('=').slice(1).join('='));
if (env.FAKE_COMMIT) execFileSync('git', ['commit', '-qam', 'fake']);

if (env.FAKE_IGNORE_TERM) process.on('SIGTERM', () => {});
if (matches(env.FAKE_HANG)) setInterval(() => {}, 1000);
else {
  if (matches(env.FAKE_SLOW)) await new Promise((resolve) => setTimeout(resolve, 300));
  const usage = env.FAKE_NO_USAGE ? {} : { input: 10, output: 5, cached: 2, cost: 0.01 };
  writeFileSync(env.ASK_REPORT, JSON.stringify({ name: 'Fake 1.0', note: env.FAKE_NOTE, session, ...usage }));
  if (matches(env.FAKE_FAIL)) {
    console.error('fake boom');
    process.exitCode = 1;
  } else {
    console.log(env.FAKE_ANSWER ?? `fake: ${stdin.trim().split('\n').pop()}`);
    process.exitCode = Number(env.FAKE_EXIT || 0);
  }
}
