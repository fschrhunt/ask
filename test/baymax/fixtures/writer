#!/usr/bin/env node
/* Cooperative simulated ask agent: replace project.txt only for write, and report a session.
 * This exercises ask's contract, not vendor tool restrictions or an OS filesystem sandbox. */
const { existsSync, readFileSync, writeFileSync } = require('node:fs');
const { join } = require('node:path');

if (process.argv[2] === 'models') {
  console.log('deterministic\tDeterministic writer');
  process.exit(0);
}

const prompt = readFileSync(0, 'utf8');
const { ASK_ACCESS, ASK_REPORT, ASK_SESSION, HOME, ASK_HOME, PATH, TMPDIR } = process.env;
if (!['read', 'write'].includes(ASK_ACCESS)) throw new Error('missing ask access contract');
if (ASK_ACCESS === 'write') writeFileSync('project.txt', prompt + '\n');
writeFileSync(ASK_REPORT, JSON.stringify({ session: ASK_SESSION || 'writer-session' }));
if (prompt === 'fail after edit') {
  console.error('simulated writer failed after editing');
  process.exit(1);
}
console.log(JSON.stringify({
  access: ASK_ACCESS, cwd: process.cwd(), home: HOME, askHome: ASK_HOME, path: PATH, tmpdir: TMPDIR,
  session: ASK_SESSION || null,
  inheritedConfig: ['XDG_CONFIG_HOME', 'CODEX_HOME', 'CLAUDE_CONFIG_DIR', 'OPENAI_API_KEY', 'ANTHROPIC_API_KEY', 'GIT_CONFIG_GLOBAL']
    .filter((name) => Object.hasOwn(process.env, name)),
  userConfig: ['.codex', '.claude', '.gitconfig'].filter((name) => existsSync(join(HOME, name))),
}));
