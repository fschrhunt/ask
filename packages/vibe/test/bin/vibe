#!/usr/bin/env node
/* Fake CLI: records only adapter inputs and emits upstream-shaped output; no model calls. */
const { appendFileSync, readFileSync } = require('node:fs');
const args = process.argv.slice(2);
const stdin = readFileSync(0, 'utf8');
const after = (flag) => args[args.indexOf(flag) + 1];
const call = { args, stdin };
call.models = JSON.parse(process.env.VIBE_MODELS);
call.active = process.env.VIBE_ACTIVE_MODEL;
call.allowed = JSON.parse(process.env.VIBE_ALLOWED_MODELS);
appendFileSync(process.env.FAKE_LOG, JSON.stringify(call) + '\n');
const emit = (event) => console.log(JSON.stringify(event));
const entry = { sessionId: 'vibe-session', generationStatus: 'completed' };
emit({ ...entry, type: 'message', role: 'assistant', content: [{ type: 'text', text: 'old answer' }] });
emit({ ...entry, type: 'message', role: 'user', content: [{ type: 'text', text: stdin }] });
emit({ ...entry, type: 'tool_result', text: 'tool noise' });
if (process.env.FAKE_MODE !== 'empty') process.stdout.write(JSON.stringify({ ...entry, type: 'message', role: 'assistant', content: [{ type: 'text', text: 'final answer' }, { type: 'image', attachment: {} }] }));
if (process.env.FAKE_MODE === 'error') { console.error('secret-provider-diagnostic'); process.exitCode = 7; }
