#!/usr/bin/env node
/* Fake CLI: records only adapter inputs and emits upstream-shaped output; no model calls. */
const { appendFileSync, readFileSync } = require('node:fs');
const args = process.argv.slice(2);
const stdin = readFileSync(0, 'utf8');
const after = (flag) => args[args.indexOf(flag) + 1];
const call = { args, stdin };
call.config = JSON.parse(readFileSync(after('--config'), 'utf8'));
appendFileSync(process.env.FAKE_LOG, JSON.stringify(call) + '\n');
if (process.env.FAKE_MODE === 'error') { console.error('secret-provider-diagnostic'); process.exit(7); }
if (process.env.FAKE_MODE !== 'empty') console.log('answer: ' + stdin);
