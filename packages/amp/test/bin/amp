#!/usr/bin/env node
/*
 * Fake `amp` for the tests: prints Amp's `--stream-json` messages. Every call is appended to
 * $FAKE_LOG as one JSON line {argv, stdin, cwd}. The answer is
 * $FAKE_ANSWER (default: the last prompt line). A prompt containing $FAKE_FAIL ends in an error
 * result; $FAKE_EXIT is the exit code.
 */
import { appendFileSync, readFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_EXIT } = process.env;
const stdin = readFileSync(0, 'utf8');
if (FAKE_LOG) appendFileSync(FAKE_LOG, JSON.stringify({ argv, stdin, cwd: process.cwd() }) + '\n');

const session_id = argv[0] === 'threads' ? argv[2] : 'T-fake';
const emit = (event) => console.log(JSON.stringify({ session_id, ...event }));
emit({ type: 'system', subtype: 'init', cwd: process.cwd(), tools: ['Bash', 'Read'], mcp_servers: [] });
if (FAKE_FAIL && stdin.includes(FAKE_FAIL)) {
  emit({ type: 'result', subtype: 'error_during_execution', is_error: true, num_turns: 1, error: 'amp boom' });
  process.exit(1);
}
const answer = FAKE_ANSWER ?? `amp: ${stdin.trim().split('\n').pop()}`;
const usage = { input_tokens: 10, cache_creation_input_tokens: 5, cache_read_input_tokens: 20, output_tokens: 7 };
emit({ type: 'assistant', message: { type: 'message', role: 'assistant', content: [{ type: 'tool_use', id: 't1', name: 'Read', input: {} }], stop_reason: 'tool_use', usage } });
emit({ type: 'assistant', message: { type: 'message', role: 'assistant', content: [{ type: 'text', text: answer }], stop_reason: 'end_turn', usage } });
emit({ type: 'result', subtype: 'success', is_error: false, num_turns: 2, result: answer });
process.exitCode = Number(FAKE_EXIT || 0);
