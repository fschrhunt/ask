#!/bin/sh
# The amp ask agent's launcher: finds Node.js 18 or newer and runs lib/amp.mjs with the same
# arguments and stdin. Node comes from $ASK_NODE, else PATH, else where Node installers put it.
# lib/ is found next to the launcher's real path, so a symlink to this file works too.
self=$0
case $self in */*) ;; *) self=./$self ;; esac
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=${self%/*}/$link ;; esac
done
lib=$(cd "${self%/*}/.." && pwd -P)/lib/amp.mjs

# usable NODE: true when NODE runs and is version 18 or newer.
usable() {
  [ -n "$1" ] && [ -x "$1" ] && "$1" -e 'process.exit(parseInt(process.versions.node) >= 18 ? 0 : 1)' 2>/dev/null
}

# The newest nvm install, by version number.
nvm=
best=-1
for dir in "$HOME"/.nvm/versions/node/v*; do
  [ -x "$dir/bin/node" ] || continue
  v=${dir##*/v}; major=${v%%.*}; v=${v#*.}; minor=${v%%.*}; patch=${v#*.}
  n=$(( major * 1000000 + minor * 1000 + ${patch%%[!0-9]*} ))
  [ "$n" -gt "$best" ] && best=$n nvm=$dir/bin/node
done

for node in "$ASK_NODE" "$(command -v node 2>/dev/null)" /opt/homebrew/bin/node /usr/local/bin/node \
  /home/linuxbrew/.linuxbrew/bin/node "$HOME/.volta/bin/node" "$nvm" \
  "$HOME/.local/share/fnm/aliases/default/bin/node" "$HOME/.local/bin/node"; do
  usable "$node" && exec "$node" "$lib" "$@"
done
echo "amp needs Node.js 18 or newer: install it from https://nodejs.org (or set ASK_NODE)" >&2
exit 1
