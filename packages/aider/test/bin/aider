#!/usr/bin/env node
/*
 * Fake `aider` for the tests: writes what Aider writes to the files named by --llm-history-file and
 * --analytics-log (and the chat and input history files), and prints a banner. Every call is
 * appended to $FAKE_LOG as one JSON line {argv, message, cwd}, message being the
 * --message-file's content. The answer is
 * $FAKE_ANSWER (default: the message's last line); with $FAKE_REFLECT Aider first answers "I need
 * a.txt", as it does before the files it names are added. A message containing $FAKE_FAIL prints
 * an error and sends nothing to the model, yet exits 0, as Aider does.
 */
import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_REFLECT } = process.env;
const after = (flag) => argv[argv.indexOf(flag) + 1];
const message = readFileSync(after('--message-file'), 'utf8');
if (FAKE_LOG) {
  appendFileSync(FAKE_LOG, JSON.stringify({ argv, message, cwd: process.cwd() }) + '\n');
}
console.log(`Aider v0.0 fake\nModel: ${after('--model')}`);
if (FAKE_FAIL && message.includes(FAKE_FAIL)) {
  console.log('litellm.AuthenticationError: bad key');
  process.exit(0);
}
writeFileSync(after('--chat-history-file'), '#### hello\n');
writeFileSync(after('--input-history-file'), '');
const stamp = '2026-10-06T12:00:00';
const answers = FAKE_REFLECT ? ['I need a.txt', FAKE_ANSWER ?? 'Final.'] : [FAKE_ANSWER ?? `fake: ${message.trim().split('\n').pop()}`];
for (const answer of answers) {
  appendFileSync(after('--llm-history-file'), `TO LLM ${stamp}\n-------\nUSER ${message}\nLLM RESPONSE ${stamp}\n${answer.split('\n').map((line) => `ASSISTANT ${line}`).join('\n')}\n`);
  const properties = { prompt_tokens: 100, completion_tokens: 10, cost: 0.01 };
  appendFileSync(after('--analytics-log'), JSON.stringify({ event: 'message_send', properties, time: 1 }) + '\n');
}
