#!/usr/bin/env node
/*
 * Fake `goose` for the tests: prints Goose's `run --output-format stream-json` events. Every call
 * is appended to $FAKE_LOG as one JSON line {argv, stdin, env}, env being the GOOSE_* variables.
 * The assistant streams a text chunk, calls a tool, then streams the answer, $FAKE_ANSWER (default:
 * the last prompt line), in two chunks; a complete event carries the session's usage. A prompt
 * containing $FAKE_FAIL ends with an error event and exit 1.
 */
import { appendFileSync, readFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL } = process.env;
const stdin = readFileSync(0, 'utf8');
if (FAKE_LOG) {
  const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => key.startsWith('GOOSE_')));
  appendFileSync(FAKE_LOG, JSON.stringify({ argv, stdin, env }) + '\n');
}
const emit = (event) => console.log(JSON.stringify(event));
const message = (id, role, content) => emit({ type: 'message', message: { id, role, created: 0, content, metadata: {} } });

message('u1', 'user', [{ type: 'text', text: stdin }]);
message('a1', 'assistant', [{ type: 'text', text: 'Let me look.' }]);
message('a1', 'assistant', [{ type: 'toolRequest', id: 't1', toolCall: { status: 'success', value: { name: 'shell', arguments: { command: 'ls' } } } }]);
message('u2', 'user', [{ type: 'toolResponse', id: 't1', toolResult: { status: 'success', value: [] } }]);
if (FAKE_FAIL && stdin.includes(FAKE_FAIL)) {
  emit({ type: 'error', error: 'goose boom' });
  process.exit(1);
}
const answer = FAKE_ANSWER ?? `goose: ${stdin.trim().split('\n').pop()}`;
message('a2', 'assistant', [{ type: 'text', text: answer.slice(0, 3) }]);
message('a2', 'assistant', [{ type: 'text', text: answer.slice(3) }]);
emit({ type: 'complete', total_tokens: 167, input_tokens: 150, output_tokens: 17, cache_read_input_tokens: 40, cost_usd: 0.003 });
