#!/usr/bin/env node
/*
 * Fake `kilo` for the tests: prints Kilo's `run --format json` events, each with sessionID. Every
 * call is appended to $FAKE_LOG as one JSON line {argv, stdin, config, env}, config being the
 * injected KILO_CONFIG_CONTENT and env the GIT_* variables. The answer is $FAKE_ANSWER (default:
 * the last prompt line) after $FAKE_STEPS steps (default 1), each with a step_finish of its usage
 * (none with $FAKE_NO_USAGE). A prompt containing $FAKE_FAIL fails with an error event;
 * $FAKE_EXIT is the exit code after an answer, with $FAKE_STDERR on stderr. `kilo models` lists a
 * few provider/model ids, some offered by several providers.
 */
import { appendFileSync, readFileSync } from 'node:fs';

const argv = process.argv.slice(2);
if (argv[0] === 'models') {
  console.log(['kilo/anthropic/claude-sonnet-5.5', 'kilo/qwen/qwen3.8-flash', 'anthropic/claude-sonnet-5.5', 'zeta/glm-5', 'beta/glm-5'].join('\n'));
  process.exit(0);
}
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_STEPS, FAKE_EXIT, FAKE_STDERR, FAKE_NO_USAGE, KILO_CONFIG_CONTENT } = process.env;
const stdin = readFileSync(0, 'utf8');
if (FAKE_LOG) {
  const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => key.startsWith('GIT_')));
  appendFileSync(FAKE_LOG, JSON.stringify({ argv, stdin, config: KILO_CONFIG_CONTENT ? JSON.parse(KILO_CONFIG_CONTENT) : null, env }) + '\n');
}
const emit = (event) => console.log(JSON.stringify({ timestamp: Date.now(), sessionID: 'ses_kilo', ...event }));
const usage = FAKE_NO_USAGE ? {} : { cost: 0.002, tokens: { input: 50, output: 6, reasoning: 1, cache: { read: 10, write: 0 } } };

if (FAKE_FAIL && stdin.includes(FAKE_FAIL)) {
  emit({ type: 'error', error: { name: 'APIError', data: { message: 'kilo boom' } } });
  process.exitCode = 1;
} else {
  const steps = Number(FAKE_STEPS || 1);
  for (let i = 0; i < steps; i++) {
    emit({ type: 'step_start', part: { type: 'step-start' } });
    if (i === steps - 1) emit({ type: 'text', part: { type: 'text', text: FAKE_ANSWER ?? `kilo: ${stdin.trim().split('\n').pop()}` } });
    if (!FAKE_NO_USAGE) emit({ type: 'step_finish', part: { type: 'step-finish', ...usage } });
  }
  if (FAKE_STDERR) process.stderr.write(`${FAKE_STDERR}\n`);
  process.exitCode = Number(FAKE_EXIT || 0);
}
