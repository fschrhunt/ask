#!/usr/bin/env node
/*
 * Fake v1/v2 CLI (FAKE_VERSION defaults to 2.0.0), emitting --format json events. Run calls go
 * to $FAKE_LOG as JSON lines {pid, argv, stdin, cwd, config, git}; all command arguments go to
 * $FAKE_CONTROL_LOG when set. config is the injected
 * OPENCODE_CONFIG_CONTENT; git records lock and fsmonitor overrides. The answer is $FAKE_ANSWER (default: the last prompt line) after
 * $FAKE_STEPS steps (default 1). A prompt containing $FAKE_FAIL fails, $FAKE_HANG never returns,
 * $FAKE_SLOW answers after 300 ms; $FAKE_PAUSE waits that many ms after reporting usage. $FAKE_EXIT is the exit code after an answer.
 * Each step is message msg_N with a step_finish of its usage, none with $FAKE_NO_USAGE, and none
 * for the answering step with $FAKE_UNFINISHED (and no step_start either when it is "text"), as
 * Opencode 2.0 prints. Version-specific export commands
 * print those steps' messages with their usage. `opencode models` lists a few provider/model ids,
 * some offered by several providers.
 */
import { appendFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const version = process.env.FAKE_VERSION ?? '2.0.0';
const v1 = /^(?:opencode\s+)?v?1\./i.test(version);
if (process.env.FAKE_CONTROL_LOG) appendFileSync(process.env.FAKE_CONTROL_LOG, JSON.stringify(argv) + '\n');
if (argv[0] === '--version') {
  console.log(version);
  process.exit(Number(process.env.FAKE_VERSION_EXIT || 0));
}
if (argv[0] === 'models') {
  const ids = ['opencode-go/m', 'opencode-go/deepseek-v4.1-flash', 'opencode-go/qwen3.8-flash', 'other/deepseek-v4.1-flash', 'opencode/deepseek-v4.1-flash'];
  console.log([...ids, 'zeta/glm-5', 'opencode/glm-5', 'zeta/kimi-k3', 'beta/kimi-k3'].join('\n'));
  process.exit(0);
}
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_HANG, FAKE_SLOW, FAKE_STEPS, FAKE_EXIT, FAKE_NO_USAGE, FAKE_UNFINISHED, OPENCODE_CONFIG_CONTENT } = process.env;
const steps = Number(FAKE_STEPS || 1);
const usage = FAKE_NO_USAGE ? {} : { cost: 0.002, tokens: { input: 50, output: 6, reasoning: 1, cache: { read: 10 } } };
if (argv[0] === 'export' || (argv[0] === 'session' && argv[1] === 'export')) {
  if (JSON.stringify(argv) !== JSON.stringify(v1 ? ['export', 'ses_fake'] : ['session', 'export', '--standalone', 'ses_fake'])) process.exit(2);
  // With $FAKE_SAVED_LATE, a file that doesn't exist yet, the first export has the last step unsaved.
  const late = process.env.FAKE_SAVED_LATE && !existsSync(process.env.FAKE_SAVED_LATE);
  if (late) writeFileSync(process.env.FAKE_SAVED_LATE, '');
  const messages = Array.from({ length: steps }, (_, i) => ({ id: `msg_${i}`, type: 'assistant', ...(late && i === steps - 1 ? { tokens: { input: 0, output: 0 } } : usage) }));
  const all = [{ id: 'msg_user', type: 'user' }, { id: 'msg_previous_turn', type: 'assistant', ...usage }, ...messages];
  console.log(JSON.stringify({ info: { id: argv.at(-1) }, messages: v1 ? all.map(({ type, ...info }) => ({ info: { ...info, role: type }, parts: [] })) : all }));
  process.exit(0);
}
if (v1 ? argv.includes('--standalone') || argv[argv.indexOf('-m') + 1].includes('#') : !argv.includes('--standalone') || argv.includes('--variant')) process.exit(2);
const stdin = readFileSync(0, 'utf8');
if (FAKE_LOG) {
  const config = OPENCODE_CONFIG_CONTENT ? JSON.parse(OPENCODE_CONFIG_CONTENT) : null;
  appendFileSync(FAKE_LOG, JSON.stringify({ pid: process.pid, argv, stdin, cwd: process.cwd(), config, git: { locks: process.env.GIT_OPTIONAL_LOCKS, count: process.env.GIT_CONFIG_COUNT, key: process.env.GIT_CONFIG_KEY_0, value: process.env.GIT_CONFIG_VALUE_0 } }) + '\n');
}
const matches = (needle) => needle && stdin.includes(needle);
const emit = (event) => console.log(JSON.stringify({ sessionID: 'ses_fake', ...event }));

if (matches(FAKE_HANG)) setInterval(() => {}, 1000);
else {
  if (matches(FAKE_SLOW)) await new Promise((resolve) => setTimeout(resolve, 300));
  if (matches(FAKE_FAIL)) {
    emit({ type: 'error', error: { message: 'opencode boom' } });
    process.exitCode = 1;
  } else {
    for (let i = 0; i < steps; i++) {
      const last = i === steps - 1;
      if (!(last && FAKE_UNFINISHED === 'text')) emit({ type: 'step_start', part: { messageID: `msg_${i}` } });
      if (last) emit({ type: 'text', part: { messageID: `msg_${i}`, text: FAKE_ANSWER ?? `opencode: ${stdin.trim().split('\n').pop()}` } });
      if (!FAKE_NO_USAGE && !(last && FAKE_UNFINISHED)) emit({ type: 'step_finish', part: { messageID: `msg_${i}`, ...usage } });
    }
    if (process.env.FAKE_PAUSE) await new Promise((resolve) => setTimeout(resolve, Number(process.env.FAKE_PAUSE)));
    process.exitCode = Number(FAKE_EXIT || 0);
  }
}
