#!/usr/bin/env node
/*
 * Fake Qwen Code printing --output-format stream-json events. Each call goes to $FAKE_LOG as a
 * JSON line {argv, stdin}. The answer is $FAKE_ANSWER (default: the last prompt line); a prompt
 * containing $FAKE_FAIL ends with an error result; $FAKE_MODEL is the model the assistant message
 * names (default: the --model it was given), as Qwen's settings fallback could change it.
 */
import { appendFileSync, readFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const stdin = readFileSync(0, 'utf8');
if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, JSON.stringify({ argv, stdin }) + '\n');
const session_id = argv.includes('--resume') ? argv[argv.indexOf('--resume') + 1] : 'sess-fake';
const model = process.env.FAKE_MODEL || argv[argv.indexOf('--model') + 1];
const emit = (event) => console.log(JSON.stringify({ session_id, ...event }));
const usage = { input_tokens: 50, output_tokens: 6, cache_read_input_tokens: 10 };

emit({ type: 'system', subtype: 'session_start', model });
if (process.env.FAKE_FAIL && stdin.includes(process.env.FAKE_FAIL)) {
  emit({ type: 'result', subtype: 'error_during_execution', is_error: true, usage: {}, error: { message: 'qwen boom' } });
  process.exit(1);
}
const answer = process.env.FAKE_ANSWER ?? `qwen: ${stdin.trim().split('\n').pop()}`;
emit({ type: 'assistant', message: { role: 'assistant', model, content: [{ type: 'text', text: answer }], usage } });
emit({ type: 'result', subtype: 'success', is_error: false, result: answer, usage: { ...usage, output_tokens: 7 } });
