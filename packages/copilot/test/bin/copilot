#!/usr/bin/env node
/*
 * Fake `copilot` for the tests: prints Copilot 1.0's `--output-format json` events and writes the
 * --usage-output-file when it exits, shaped like the real ones. Every call is appended to $FAKE_LOG
 * as one JSON line {argv, stdin, cwd, gitLocks}, gitLocks being GIT_OPTIONAL_LOCKS. The answer is
 * $FAKE_ANSWER (default: the last prompt line), after a turn that narrates and asks for a tool when
 * $FAKE_TOOLS is set. A prompt containing $FAKE_FAIL fails with a session.error. Like Copilot, the
 * usage file counts the whole session: each run appends a session.shutdown event with the totals to
 * $COPILOT_HOME/session-state/ID/events.jsonl, and a resumed session adds to the last one.
 */
import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const argv = process.argv.slice(2);
const stdin = readFileSync(0, 'utf8');
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_TOOLS, GIT_OPTIONAL_LOCKS } = process.env;
if (FAKE_LOG) appendFileSync(FAKE_LOG, JSON.stringify({ argv, stdin, cwd: process.cwd(), gitLocks: GIT_OPTIONAL_LOCKS ?? null }) + '\n');
const after = (flag) => argv[argv.indexOf(flag) + 1];
const model = after('--model');
const emit = (type, data) => console.log(JSON.stringify({ type, data, id: 'e', timestamp: new Date().toISOString(), parentId: null }));
const message = (content, toolRequests = []) => emit('assistant.message', { messageId: 'm', model, content, toolRequests });

emit('user.message', { content: stdin });
let exitCode = 0;
if (FAKE_FAIL && stdin.includes(FAKE_FAIL)) {
  emit('session.error', { errorType: 'query', message: 'copilot boom', statusCode: 400 });
  exitCode = 1;
} else {
  if (FAKE_TOOLS) {
    message('Let me look.', [{ toolCallId: 't', name: 'view', arguments: { path: '.' } }]);
    console.log(JSON.stringify({ type: 'assistant.message', agentId: 'sub', data: { messageId: 's', content: 'a subagent says this', toolRequests: [] } }));
  }
  message(FAKE_ANSWER ?? `copilot: ${stdin.trim().split('\n').pop()}`);
}
console.log(JSON.stringify({ type: 'result', sessionId: after('--session-id'), exitCode, usage: { premiumRequests: 1 } }));
const state = join(process.env.COPILOT_HOME, 'session-state', after('--session-id'));
let saved = {};
try {
  saved = JSON.parse(readFileSync(join(state, 'events.jsonl'), 'utf8').trim().split('\n').pop()).data.modelMetrics;
} catch {}
const so = saved[model]?.usage || { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0 };
const usage = exitCode ? so : { inputTokens: so.inputTokens + 120, outputTokens: so.outputTokens + 5, cacheReadTokens: so.cacheReadTokens + 40 };
const modelMetrics = { ...saved, [model]: { requests: { count: 1, cost: 1 }, usage } };
writeFileSync(after('--usage-output-file'), JSON.stringify({ totalPremiumRequestCost: 1, modelMetrics }));
mkdirSync(state, { recursive: true });
appendFileSync(join(state, 'events.jsonl'), JSON.stringify({ type: 'session.shutdown', data: { shutdownType: 'routine', modelMetrics } }) + '\n');
process.exitCode = exitCode;
