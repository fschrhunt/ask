#!/usr/bin/env node
/*
 * Fake `cline` for the tests: with --acp, an Agent Client Protocol server on stdio, as Cline's. Its
 * argv and CLINE_* environment, then every request it gets and every permission answer, are
 * appended to $FAKE_LOG as JSON lines: {argv, env}, {method, params}, {tool, outcome}. session/new
 * offers two models and fails as Cline does when signed out with $FAKE_SIGNED_OUT; session/load
 * replays an old message first. session/prompt says something, asks permission for each tool in
 * $FAKE_TOOLS (comma-separated), then answers $FAKE_ANSWER (default: the last prompt line) in two
 * chunks and stops with $FAKE_STOP (default end_turn).
 */
import { appendFileSync } from 'node:fs';
import { createInterface } from 'node:readline';

const { FAKE_LOG, FAKE_ANSWER, FAKE_TOOLS, FAKE_STOP, FAKE_SIGNED_OUT } = process.env;
const log = (entry) => FAKE_LOG && appendFileSync(FAKE_LOG, `${JSON.stringify(entry)}\n`);
log({ argv: process.argv.slice(2), env: Object.fromEntries(Object.entries(process.env).filter(([key]) => key.startsWith('CLINE_'))) });
if (process.argv[2] !== '--acp') process.exit(2);

const send = (message) => process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...message })}\n`);
const update = (sessionId, u) => send({ method: 'session/update', params: { sessionId, update: u } });
const models = { availableModels: [{ modelId: 'anthropic/claude-sonnet-5.5', name: 'Claude Sonnet 5.5' }, { modelId: 'openai/gpt-6.1' }], currentModelId: 'openai/gpt-6.1' };
const waiting = new Map();
let next = 1000;
/* Sends a request to the client and resolves with its result. */
const ask = (method, params) => new Promise((resolve) => {
  const id = ++next;
  waiting.set(id, resolve);
  send({ id, method, params });
});

createInterface({ input: process.stdin }).on('line', async (line) => {
  const message = JSON.parse(line);
  if (!message.method) {
    waiting.get(message.id)?.(message.result);
    return;
  }
  log({ method: message.method, params: message.params });
  const { id, method, params } = message;
  if (method === 'initialize') send({ id, result: { protocolVersion: 1, agentCapabilities: { loadSession: true } } });
  else if (method === 'session/new') {
    if (FAKE_SIGNED_OUT) send({ id, error: { code: -32000, message: 'Authentication required', data: { message: 'Call authenticate before starting a session' } } });
    else send({ id, result: { sessionId: 'ses_cline', models } });
  } else if (method === 'session/load') {
    update(params.sessionId, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'old answer' } });
    send({ id, result: { models } });
  } else if (method === 'session/set_config_option' || method === 'session/set_mode') send({ id, result: {} });
  else if (method === 'session/prompt') {
    const { sessionId } = params;
    const text = params.prompt.map((block) => block.text).join('');
    update(sessionId, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'Let me look.' } });
    for (const tool of (FAKE_TOOLS || '').split(',').filter(Boolean)) {
      const toolCall = { toolCallId: `call_${tool}`, title: `${tool}: something`, status: 'pending' };
      update(sessionId, { sessionUpdate: 'tool_call', ...toolCall });
      const { outcome } = await ask('session/request_permission', { sessionId, toolCall, options: [] });
      log({ tool, outcome: outcome.optionId });
    }
    const answer = FAKE_ANSWER ?? `cline: ${text.trim().split('\n').pop()}`;
    update(sessionId, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: answer.slice(0, 3) } });
    update(sessionId, { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: answer.slice(3) } });
    send({ id, result: { stopReason: FAKE_STOP || 'end_turn' } });
  } else send({ id, error: { code: -32601, message: `unknown method ${method}` } });
});
