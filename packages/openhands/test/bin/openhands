#!/usr/bin/env node
/* Fake CLI: records only adapter inputs and emits upstream-shaped output; no model calls. */
const { appendFileSync, readFileSync } = require('node:fs');
const args = process.argv.slice(2);
const stdin = readFileSync(0, 'utf8');
const after = (flag) => args[args.indexOf(flag) + 1];
const call = { args, stdin };
call.model = process.env.LLM_MODEL;
appendFileSync(process.env.FAKE_LOG, JSON.stringify(call) + '\n');
const emit = (event) => console.log(JSON.stringify(event));
console.log('Starting OpenHands');
emit({ kind: 'ObservationEvent', source: 'environment', observation: { output: 'tool noise' } });
if (process.env.FAKE_MODE !== 'empty') {
  emit({ kind: 'MessageEvent', source: 'agent', llm_message: { role: 'assistant', content: [{ type: 'text', text: 'interim answer' }] } });
  emit({ kind: 'ActionEvent', source: 'agent', action: { kind: 'FinishAction', message: 'final answer' } });
}
if (process.env.FAKE_MODE === 'event-error') emit({ kind: 'ConversationErrorEvent', detail: 'secret-provider-diagnostic' });
console.log('CONVERSATION SUMMARY: tool noise');
process.stdout.write('Conversation ID: 0123456789abcdef0123456789abcdef');
if (process.env.FAKE_MODE === 'error') { console.error('secret-provider-diagnostic'); process.exitCode = 7; }
