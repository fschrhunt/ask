#!/usr/bin/env node
/*
 * Fake `agent` for the tests: prints Cursor's `--output-format stream-json` events. Every
 * call is appended to $FAKE_LOG as one JSON line {argv, cwd}. The prompt is the last argument; the
 * answer is $FAKE_ANSWER (default: the prompt), sent as two assistant messages around a tool call,
 * the way Cursor does, with a result that concatenates them. A prompt containing $FAKE_FAIL exits
 * 1 with a message on stderr; $FAKE_ERROR_RESULT ends with an is_error result instead.
 */
import { appendFileSync } from 'node:fs';

const argv = process.argv.slice(2);
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_ERROR_RESULT } = process.env;
if (FAKE_LOG) appendFileSync(FAKE_LOG, JSON.stringify({ argv, cwd: process.cwd() }) + '\n');
const prompt = argv.at(-1);
const session_id = argv.includes('--resume') ? argv[argv.indexOf('--resume') + 1] : 'chat-fake';
const emit = (event) => console.log(JSON.stringify({ session_id, ...event }));
const message = (text) => ({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text }] } });

emit({ type: 'system', subtype: 'init', apiKeySource: 'env', cwd: process.cwd(), model: 'Fake Model', permissionMode: 'default' });
if (FAKE_FAIL && prompt.includes(FAKE_FAIL)) {
  console.error('cursor boom');
  process.exit(1);
}
if (FAKE_ERROR_RESULT) {
  emit({ type: 'result', subtype: 'error', is_error: true, result: 'cursor refused' });
  process.exit(0);
}
const answer = FAKE_ANSWER ?? prompt;
emit(message('Let me look.'));
emit({ type: 'tool_call', subtype: 'started', call_id: 'c1', tool_call: { readToolCall: { args: { path: 'a.txt' } } } });
emit(message(answer));
emit({ type: 'result', subtype: 'success', is_error: false, result: `Let me look.${answer}` });
