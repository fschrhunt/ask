#!/usr/bin/env node
/*
 * Fake Kimi Code. `provider list --json` prints a models table; a run prints --output-format
 * stream-json lines, a tool turn first when $FAKE_TOOLS is set, then the answer and the resume
 * hint. Each run goes to $FAKE_LOG as {argv, agentFile, modelEnv}, agentFile being the content of
 * the --agent-file it was given. The answer is $FAKE_ANSWER (default: the prompt's last line); a
 * prompt containing $FAKE_FAIL fails with "kimi boom" on stderr. The worst case of Kimi's session
 * binding is modelled: a session started with --agent-file remembers the file's path in
 * $FAKE_STATE, and resuming it re-reads that file (failing if it is gone, as an unknown profile)
 * and records what it allows as `restored`; --agent-file with --session is rejected, as in Kimi.
 */
import { appendFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs';

const argv = process.argv.slice(2);
if (argv[0] === 'provider') {
  console.log(JSON.stringify({
    providers: { 'managed:kimi-code': {}, other: {} },
    models: {
      'kimi-code/kimi-for-coding': { provider: 'managed:kimi-code', model: 'kimi-for-coding', display_name: 'Kimi for Coding' },
      'moon/k3': { provider: 'other', model: 'k3' },
      'a/shared': { provider: 'other', model: 'shared' },
      'b/shared': { provider: 'managed:kimi-code', model: 'shared' },
    },
  }));
  process.exit(0);
}
const prompt = argv.find((a) => a.startsWith('--prompt=')).slice('--prompt='.length);
const agentFile = argv.includes('--agent-file') ? readFileSync(argv[argv.indexOf('--agent-file') + 1], 'utf8') : null;
const resuming = argv.includes('--session') ? argv[argv.indexOf('--session') + 1] : null;
const state = existsSync(process.env.FAKE_STATE || '/nonexistent') ? JSON.parse(readFileSync(process.env.FAKE_STATE, 'utf8')) : {};
if (resuming && argv.includes('--agent-file')) {
  console.error('Cannot combine --agent/--agent-file with --session/--continue');
  process.exit(1);
}
let restored = null;
if (resuming && state[resuming]) {
  if (!existsSync(state[resuming])) {
    console.error('Unknown agent profile: "ask-read"');
    process.exit(1);
  }
  restored = readFileSync(state[resuming], 'utf8');
}
if (!resuming && argv.includes('--agent-file') && process.env.FAKE_STATE) writeFileSync(process.env.FAKE_STATE, JSON.stringify({ ...state, 'sess-fake': argv[argv.indexOf('--agent-file') + 1] }));
if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, JSON.stringify({ argv, agentFile, restored, modelEnv: process.env.KIMI_MODEL_NAME ?? null }) + '\n');
if (process.env.FAKE_FAIL && prompt.includes(process.env.FAKE_FAIL)) {
  console.error('thinking...\nkimi boom');
  process.exit(1);
}
const line = (event) => console.log(JSON.stringify(event));
if (process.env.FAKE_TOOLS) {
  line({ role: 'assistant', content: 'let me look', tool_calls: [{ type: 'function', id: 't1', function: { name: 'Read', arguments: '{}' } }] });
  line({ role: 'tool', tool_call_id: 't1', content: 'file text' });
}
line({ role: 'assistant', content: process.env.FAKE_ANSWER ?? `kimi: ${prompt.trim().split('\n').pop()}` });
const session_id = resuming ?? 'sess-fake';
line({ role: 'meta', type: 'session.resume_hint', session_id, command: `kimi -r ${session_id}` });
