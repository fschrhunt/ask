#!/usr/bin/env node
/* Fake e RPC v2: validates the tool allowlist and records requests; no provider is called. */
const { appendFileSync } = require('node:fs');
const { createInterface } = require('node:readline');
appendFileSync(process.env.FAKE_LOG, JSON.stringify({ argv: process.argv.slice(2), cwd: process.cwd() }) + '\n');
const emit = (message) => console.log(JSON.stringify(message));
const u = { input_tokens: 20, output_tokens: 5, cache_read_tokens: 3, cache_write_5m_tokens: 2, cache_write_1h_tokens: 1 };
const path = '/saved/e-session.jsonl';
const lines = createInterface({ input: process.stdin });
let prompts = 0;
lines.on('line', (line) => {
  const { id, method, params } = JSON.parse(line);
  appendFileSync(process.env.FAKE_LOG, JSON.stringify({ method, params }) + '\n');
  const reply = (result) => emit({ id, result });
  if (method === 'hello') reply({ protocol: Number(process.env.FAKE_PROTOCOL || 2) });
  else if (method === 'models.list') reply({ models: [{ model: 'provider/model' }, { model: 'other/model' }, { model: 'provider/model' }] });
  else if (method === 'session.create') {
    if (params.tools?.includes('__ask_read_only_probe__') && !process.env.FAKE_IGNORE_TOOLS) emit({ id, error: 'unknown built-in tool in allowlist: `__ask_read_only_probe__`' });
    else if (process.env.FAKE_UNTRUSTED) emit({ id, error: 'working directory is not trusted; run e trust' });
    else reply({ session: 'transient-id', model: params.model, path: params.resume || null });
  } else if (method === 'session.info') reply({ path: prompts ? path : null });
  else if (method === 'session.prompt') {
    prompts++;
    const event = (body) => emit({ session: params.session, request: id, ...body });
    event({ type: 'turn_start' });
    event({ type: 'usage', ...u });
    event({ type: 'text', delta: 'streamed text should not leak' });
    if (process.env.FAKE_DIE) { process.exitCode = 1; lines.close(); process.stdin.destroy(); return; }
    setTimeout(() => {
      event({ type: 'usage', ...u });
      reply({ final_output: 'answer', model: 'provider/model', path, usage: { ...u, input_tokens: 40, output_tokens: 10, cache_read_tokens: 6, prompt_tokens: 52 }, cost_usd: process.env.FAKE_NO_COST ? null : 0.02, error: process.env.FAKE_ERROR ? 'provider failed' : null, aborted: !!process.env.FAKE_ABORT, warnings: [] });
    }, Number(process.env.FAKE_PAUSE || 0));
  }
});
process.stdin.on('end', () => { process.exitCode = Number(process.env.FAKE_EXIT || process.exitCode || 0); });
